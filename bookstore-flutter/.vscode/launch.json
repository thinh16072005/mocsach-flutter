{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "BookStore Flutter (Web - Port 3000)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "args": [
        "-d",
        "chrome",
        "--web-port",
        "3000"
      ]
    },
    {
      "name": "BookStore Flutter (Android Emulator)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "args": [
        "-d",
        "emulator-5554"
      ]
    }
  ]
}
